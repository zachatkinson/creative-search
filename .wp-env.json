{
	"core": "https://wordpress.org/wordpress-7.1.3.zip",
	"phpVersion": "8.5",
	"plugins": [],
	"mappings": {
		"wp-content/plugins/woocommerce": "https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip",
		"wp-content/plugins/plugin-check": "https://downloads.wordpress.org/plugin/plugin-check.2.1.0.zip",
		"wp-content/plugins/creative-search": "."
	},
	"port": 8890,
	"testsPort": 8891,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate woocommerce plugin-check creative-search && wp-env run tests-cli wp plugin activate woocommerce creative-search"
	}
}
