{
	// The plugin outside the domain, at 90 %. src/Domain has its own 100 % run in infection-domain.json5 (docs/DECISIONS.md D-019, D-030). WordPress-bound directories are tested by the integration suite instead (D-048).
	"$schema": "vendor/infection/infection/resources/schema.json",
	"source": {
		"directories": [
			"src"
		],
		"excludes": [
			"Domain",
			"Install",
			"Index",
			"Hooks",
			"Cli",
			"Repository",
			"Search",
			"Rest",
			"Block",
			"Support/Options.php",
			"Support/Tables.php",
			"Plugin.php",
			"Hookable.php"
		]
	},
	"bootstrap": "tests/bootstrap.php",
	"timeout": 20,
	"logs": {
		"text": "tmp/infection.log",
		"summary": "tmp/infection-summary.log",
		"json": "tmp/infection.json"
	},
	"phpUnit": {
		"configDir": "."
	},
	"testFramework": "phpunit",
	"testFrameworkOptions": "--testsuite=unit --exclude-group=benchmark",
	"mutators": {
		"@default": true
	},
	"minMsi": 90,
	"minCoveredMsi": 90
}
