{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "creative-search/search",
	"version": "1.6.5",
	"title": "Product Search",
	"category": "woocommerce",
	"icon": "search",
	"description": "A product search bar with live suggestions: photos, prices, stock, categories and brands as the shopper types. Works without JavaScript.",
	"keywords": [ "search", "products", "woocommerce", "suggestions" ],
	"textdomain": "creative-search",
	"attributes": {
		"labelVisible": { "type": "boolean" },
		"placeholder": { "type": "string" },
		"limit": { "type": "integer", "minimum": 1, "maximum": 10 },
		"panelMax": { "type": "integer", "minimum": 4, "maximum": 12 },
		"panelMaxPhone": { "type": "integer", "minimum": 3, "maximum": 8 },
		"showPrices": { "type": "boolean" },
		"showStock": { "type": "boolean" },
		"showTerms": { "type": "boolean" },
		"recentSearches": { "type": "boolean" },
		"panelPosition": {
			"type": "string",
			"enum": [ "auto", "below", "above" ]
		},
		"mode": {
			"type": "string",
			"enum": [ "field", "button" ],
			"default": "field"
		},
		"dimPage": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"interactivity": true,
		"spacing": { "margin": true },
		"typography": { "fontSize": true }
	},
	"example": {},
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style-editor.css",
	"viewScriptModule": "file:./view.js"
}
