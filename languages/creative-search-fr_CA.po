#. Plugin Name of the plugin
#: creative-search.php
#: src/Block/Widget.php:56
msgid "Creative Search"
msgstr "Creative Search"

#. Plugin URI of the plugin
#: creative-search.php
msgid "https://creativebranding.ca"
msgstr "https://creativebranding.ca"

#. Description of the plugin
#: creative-search.php
msgid "Search for WooCommerce: live suggestions as the shopper types, typo tolerance, SKU and attribute matching, an index of its own, search analytics and an accessible search bar."
msgstr "La recherche pour WooCommerce : suggestions en direct pendant la saisie, tolérance aux fautes de frappe, recherche par UGS et par attribut, un index qui lui est propre, des statistiques de recherche et une barre de recherche accessible."

#. Author of the plugin
#: creative-search.php
msgid "Creative Branding"
msgstr "Creative Branding"

#. Author URI of the plugin
#: creative-search.php
msgid "https://zachatkinson.com"
msgstr "https://zachatkinson.com"

#: creative-search.php:39
msgid "Creative Search: run \"composer install\" before activating the plugin."
msgstr "Creative Search : exécutez \"composer install\" avant d’activer l’extension."

